{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iwinties/ai-foundation/schemas/task-graph.schema.json",
  "title": "Plan task graph",
  "description": ".ai/plans/PLAN-YYYYMMDD-<slug>/tasks.yaml, parsed to a JSON object.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "plan", "tasks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "handoff_contract_version": {
      "description": "Opt-in marker for the completed-dependencies-v1 handoff projection. Present (== 1) opts the plan into provides-bound handoffs; absent retains v1 behavior.",
      "const": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "status", "base_commit"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PLAN-[0-9]{8}-[a-z0-9-]+$"
        },
        "status": {
          "enum": ["draft", "approved", "active", "done", "abandoned"]
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pending", "claimed", "in_progress", "blocked", "review", "done", "cancelled"]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "provides": {
          "description": "Stable outputs a dependent task consumes, not implementation narrative. Required on every non-cancelled task referenced by another task's depends_on in opted-in plans.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileChange"
          }
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testSpec"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["pending", "claimed", "in_progress", "blocked", "review"]
              }
            }
          },
          "then": {
            "required": ["depends_on", "files", "instructions", "acceptance", "tests", "evidence"]
          }
        }
      ]
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "operation"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": ["create", "modify", "delete"]
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"operation": {"const": "modify"}},
            "required": ["operation"]
          },
          "then": {
            "required": ["anchor"],
            "properties": {"anchor": {"minLength": 1}}
          }
        }
      ]
    },
    "testSpec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
