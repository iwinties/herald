{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iwinties/ai-foundation/schemas/project-context.schema.json",
  "title": "Project context",
  "description": ".ai/context.yaml \u2014 per-repo pointer to the foundation, memory roots, and plans root.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project",
    "foundation",
    "memory",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "repo",
        "default_branch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "repo",
        "version"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "active_root",
        "archive_root"
      ],
      "properties": {
        "active_root": {
          "type": "string",
          "minLength": 1
        },
        "archive_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plans": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agents": {
      "type": "object",
      "description": "Optional per-repo model/effort overrides for aictl agent run (beats registry/agents.yaml, beaten by CLI flags).",
      "additionalProperties": false,
      "patternProperties": {
        "^(plan|implement|review)$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "enum": ["opus", "sonnet", "haiku"]
                },
                "effort": {
                  "type": "string",
                  "enum": ["low", "medium", "high", "xhigh", "max"]
                }
              }
            },
            "codex": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "enum": ["gpt-6-astra", "gpt-6.2-sol", "gpt-6.1-sol", "gpt-6-sol", "gpt-5.6-sol", "gpt-5.6-terra"]
                },
                "effort": {
                  "type": "string",
                  "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
                }
              }
            }
          }
        }
      }
    }
  }
}
