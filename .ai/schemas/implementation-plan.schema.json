{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iwinties/ai-foundation/schemas/implementation-plan.schema.json",
  "title": "Implementation plan frontmatter",
  "description": "YAML frontmatter of .ai/plans/PLAN-YYYYMMDD-<slug>/plan.md. Body sections (Goal, Non-goals, Current behavior, Design, Tasks summary, Risks, Documentation impact, Memory impact) are markdown and out of scope.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "status", "owner", "base_commit", "created"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{8}-[a-z0-9-]+$"
    },
    "status": {
      "enum": ["draft", "approved", "active", "done", "abandoned"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
